{{ 'section-dst-testimonials.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sec = section.settings
-%}

<div
  class="dst-testimonials color-{{ sec.color_scheme }} gradient"
  style="--dst-tm-pt: {{ sec.padding_top }}px; --dst-tm-pb: {{ sec.padding_bottom }}px;"
>
  <div class="page-width">

    {%- if sec.eyebrow != blank -%}
      <p class="dst-testimonials__eyebrow">{{ sec.eyebrow }}</p>
    {%- endif -%}
    {%- if sec.heading != blank -%}
      <h2 class="dst-testimonials__heading h2">{{ sec.heading }}</h2>
    {%- endif -%}
    {%- if sec.subheading != blank -%}
      <p class="dst-testimonials__subheading">{{ sec.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="dst-testimonials__grid" style="--dst-tm-columns-d: {{ sec.columns_desktop }};" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'quote' -%}
            {%- assign rating = block.settings.rating | default: 5 -%}
            <li class="dst-testimonials__item" {{ block.shopify_attributes }}>
              <figure class="dst-testimonials__card">
                {%- if rating > 0 -%}
                  <div class="dst-testimonials__stars" aria-label="{{ rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      <span class="dst-testimonials__star{% if i <= rating %} is-on{% endif %}" aria-hidden="true">★</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <blockquote class="dst-testimonials__quote">
                  {{ block.settings.quote }}
                </blockquote>
                <figcaption class="dst-testimonials__author">
                  {%- if block.settings.avatar != blank -%}
                    <img
                      class="dst-testimonials__avatar"
                      src="{{ block.settings.avatar | image_url: width: 96 }}"
                      width="48"
                      height="48"
                      alt="{{ block.settings.name | escape }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <span class="dst-testimonials__author-text">
                    <span class="dst-testimonials__name">{{ block.settings.name }}</span>
                    {%- if block.settings.role != blank -%}
                      <span class="dst-testimonials__role">{{ block.settings.role }}</span>
                    {%- endif -%}
                  </span>
                </figcaption>
              </figure>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section section-dst-testimonials",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1, "max": 4, "step": 1, "default": 3
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 60, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 60, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Share what a customer said about your product.</p>" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer" },
        { "type": "text", "id": "role", "label": "Role or location" },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0, "max": 5, "step": 1, "default": 5
        },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
