{{ 'section-dst-image-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sec = section.settings
-%}

<div
  class="dst-igrid color-{{ sec.color_scheme }} gradient"
  style="--dst-igrid-pt: {{ sec.padding_top }}px; --dst-igrid-pb: {{ sec.padding_bottom }}px;"
>
  <div class="{% if sec.full_width %}dst-igrid__container--full{% else %}page-width{% endif %}">

    {%- if sec.heading != blank -%}
      <h2 class="dst-igrid__heading h2">{{ sec.heading }}</h2>
    {%- endif -%}
    {%- if sec.subheading != blank -%}
      <p class="dst-igrid__subheading">{{ sec.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="dst-igrid__grid"
        style="--dst-igrid-cols-d: {{ sec.columns_desktop }};"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- assign b = block.settings -%}
            <li class="dst-igrid__item" {{ block.shopify_attributes }}>
              {%- if b.link != blank -%}
                <a href="{{ b.link }}" class="dst-igrid__link" aria-label="{{ b.aria_label | default: b.caption | default: 'View image' | escape }}">
              {%- endif -%}
                {%- if b.image != blank -%}
                  <img
                    class="dst-igrid__img"
                    src="{{ b.image | image_url: width: 600 }}"
                    srcset="{{ b.image | image_url: width: 300 }} 300w, {{ b.image | image_url: width: 450 }} 450w, {{ b.image | image_url: width: 600 }} 600w, {{ b.image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 990px) {{ 100 | divided_by: sec.columns_desktop }}vw, 50vw"
                    width="{{ b.image.width }}"
                    height="{{ b.image.height }}"
                    alt="{{ b.image.alt | default: b.caption | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="dst-igrid__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
                {%- if b.caption != blank -%}
                  <span class="dst-igrid__caption">{{ b.caption }}</span>
                {%- endif -%}
              {%- if b.link != blank -%}
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Image Grid",
  "tag": "section",
  "class": "section section-dst-image-grid",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "header",
      "content": "Layout"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2, "max": 6, "step": 1, "default": 6
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "aria_label", "label": "Link label for screen readers" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Image Grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
