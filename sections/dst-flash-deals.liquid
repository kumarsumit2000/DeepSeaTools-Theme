{{ 'section-dst-flash-deals.css' | asset_url | stylesheet_tag }}
{{ 'dst-countdown.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dst-countdown.js' | asset_url }}" defer></script>

{%- liquid
  assign sec = section.settings
-%}

<div
  class="dst-deals color-{{ sec.color_scheme }} gradient"
  style="--dst-deals-pt: {{ sec.padding_top }}px; --dst-deals-pb: {{ sec.padding_bottom }}px;"
>
  <div class="page-width">

    {%- if sec.heading != blank -%}
      <h2 class="dst-deals__heading h2">{{ sec.heading }}</h2>
    {%- endif -%}
    {%- if sec.subheading != blank -%}
      <p class="dst-deals__subheading">{{ sec.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="dst-deals__grid" style="--dst-deals-cols-d: {{ sec.columns_desktop }};" role="list">
        {%- assign skip_styles = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'deal' -%}
            {%- assign p = all_products[block.settings.product] -%}
            {%- if p != blank and p.id -%}
              <li class="dst-deals__item" {{ block.shopify_attributes }}>
                <div class="dst-deals__card">
                  {% render 'card-product',
                    card_product: p,
                    media_aspect_ratio: 'square',
                    show_secondary_image: true,
                    lazy_load: true,
                    skip_styles: skip_styles,
                    section_id: section.id,
                    dst_buy_now: sec.dst_buy_now
                  %}
                  {%- assign end_date = block.settings.end_time -%}
                  {%- if end_date != blank -%}
                    <div class="dst-deals__countdown-wrap">
                      {% render 'dst-countdown', end: end_date, size: 'sm', show_days: sec.show_days %}
                    </div>
                  {%- endif -%}
                </div>
              </li>
              {%- assign skip_styles = true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="dst-deals__empty">{{ 'sections.dst_flash_deals.no_deals' | t | default: 'Add deal blocks in the theme editor.' }}</p>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Flash Deals",
  "tag": "section",
  "class": "section section-dst-flash-deals",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flash Deals" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2, "max": 5, "step": 1, "default": 4
    },
    { "type": "checkbox", "id": "show_days", "label": "Show days in countdown", "default": true },
    { "type": "checkbox", "id": "dst_buy_now", "label": "Show Buy now button on product cards", "default": true },
    {
      "type": "header",
      "content": "Section padding"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "deal",
      "name": "Deal",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "text",
          "id": "end_time",
          "label": "Sale ends",
          "info": "Format YYYY-MM-DD HH:MM (24-hour, UTC). Example: 2026-09-15 23:59"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Flash Deals",
      "blocks": [
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" },
        { "type": "deal" }
      ]
    }
  ]
}
{% endschema %}
