{{ 'section-dst-collection-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dst-collection-tabs.js' | asset_url }}" defer></script>

{%- liquid
  assign sec = section.settings
-%}

<div
  class="dst-tabs color-{{ sec.color_scheme }} gradient"
  style="--dst-tabs-pt: {{ sec.padding_top }}px; --dst-tabs-pb: {{ sec.padding_bottom }}px;"
>
  <div class="page-width">

    {%- if sec.heading != blank -%}
      <h2 class="dst-tabs__heading h2">{{ sec.heading }}</h2>
    {%- endif -%}
    {%- if sec.subheading != blank -%}
      <p class="dst-tabs__subheading">{{ sec.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <dst-collection-tabs class="dst-tabs__component">
        <div class="dst-tabs__nav" role="tablist" aria-label="{{ 'sections.dst_tabs.label' | t | default: sec.heading | default: 'Collections' | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- assign tab_id = 'dst-tab-' | append: section.id | append: '-' | append: forloop.index -%}
              {%- assign panel_id = 'dst-panel-' | append: section.id | append: '-' | append: forloop.index -%}
              <button
                type="button"
                role="tab"
                id="{{ tab_id }}"
                class="dst-tabs__tab{% if forloop.first %} is-active{% endif %}"
                aria-controls="{{ panel_id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-tab-target="{{ panel_id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.title | default: block.settings.collection.title | default: 'Tab' }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="dst-tabs__panels">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- assign tab_id = 'dst-tab-' | append: section.id | append: '-' | append: forloop.index -%}
              {%- assign panel_id = 'dst-panel-' | append: section.id | append: '-' | append: forloop.index -%}
              {%- assign coll = block.settings.collection -%}
              <div
                role="tabpanel"
                id="{{ panel_id }}"
                class="dst-tabs__panel{% if forloop.first %} is-active{% endif %}"
                aria-labelledby="{{ tab_id }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                {%- if coll != blank -%}
                  <ul
                    class="dst-tabs__products"
                    style="--dst-tabs-cols-d: {{ sec.columns_desktop }};"
                    role="list"
                  >
                    {%- assign limit = sec.products_to_show | default: 8 -%}
                    {%- for product in coll.products limit: limit -%}
                      <li class="dst-tabs__product">
                        {% render 'card-product',
                          card_product: product,
                          media_aspect_ratio: 'square',
                          show_secondary_image: true,
                          show_vendor: false,
                          show_rating: false,
                          lazy_load: true,
                          skip_styles: forloop.index0 > 0,
                          section_id: section.id,
                          dst_buy_now: sec.dst_buy_now
                        %}
                      </li>
                    {%- else -%}
                      <li class="dst-tabs__empty">{{ 'sections.dst_tabs.no_products' | t | default: 'No products in this collection yet.' }}</li>
                    {%- endfor -%}
                  </ul>
                  {%- if sec.show_view_all and coll.url != blank -%}
                    <p class="dst-tabs__view-all">
                      <a href="{{ coll.url }}" class="button button--secondary">
                        {{ 'sections.dst_tabs.view_all' | t | default: 'View all' }}
                      </a>
                    </p>
                  {%- endif -%}
                {%- else -%}
                  <p class="dst-tabs__empty">{{ 'sections.dst_tabs.no_collection' | t | default: 'Choose a collection for this tab.' }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </dst-collection-tabs>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Collection Tabs",
  "tag": "section",
  "class": "section section-dst-collection-tabs",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our products" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2, "max": 5, "step": 1, "default": 4
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products per tab",
      "min": 2, "max": 16, "step": 1, "default": 8
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" button under tab", "default": true },
    { "type": "checkbox", "id": "dst_buy_now", "label": "Show Buy now button on product cards", "default": false },
    {
      "type": "header",
      "content": "Section padding"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab label", "info": "Leave blank to use the collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection Tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
